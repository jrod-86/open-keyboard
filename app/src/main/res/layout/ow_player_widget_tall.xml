<?xml version="1.0" encoding="utf-8"?>
<!-- Open Waves player widget, big size (test 311): large cover on top, then the song and the controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ow_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ow_w_bg"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="12dp">
    <ImageView android:id="@+id/ow_w_cover" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scaleType="fitCenter" android:src="@drawable/open_waves_widget_icon" android:contentDescription="Cover" />
    <TextView android:id="@+id/ow_w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:paddingTop="6dp" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:text="Open Waves" />
    <TextView android:id="@+id/ow_w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:textColor="#B3FFFFFF" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:text="Tap play to carry on" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/ow_w_prev" android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp"
            android:src="@drawable/ow_w_prev" android:contentDescription="Previous" />
        <ImageView android:id="@+id/ow_w_play" android:layout_width="56dp" android:layout_height="56dp" android:padding="8dp"
            android:src="@drawable/ow_w_play" android:contentDescription="Play" />
        <ImageView android:id="@+id/ow_w_next" android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp"
            android:src="@drawable/ow_w_next" android:contentDescription="Next" />
    </LinearLayout>
</LinearLayout>
