<?xml version="1.0" encoding="utf-8"?>
<!-- Open Waves player widget (test 311): cover, song, artist and controls in one row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ow_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ow_w_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">
    <ImageView android:id="@+id/ow_w_cover" android:layout_width="52dp" android:layout_height="52dp"
        android:scaleType="centerCrop" android:src="@drawable/open_waves_widget_icon" android:contentDescription="Cover" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/ow_w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:text="Open Waves" />
        <TextView android:id="@+id/ow_w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:text="Tap play to carry on" />
    </LinearLayout>
    <ImageView android:id="@+id/ow_w_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp"
        android:src="@drawable/ow_w_prev" android:contentDescription="Previous" />
    <ImageView android:id="@+id/ow_w_play" android:layout_width="46dp" android:layout_height="46dp" android:padding="6dp"
        android:src="@drawable/ow_w_play" android:contentDescription="Play" />
    <ImageView android:id="@+id/ow_w_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp"
        android:src="@drawable/ow_w_next" android:contentDescription="Next" />
</LinearLayout>
